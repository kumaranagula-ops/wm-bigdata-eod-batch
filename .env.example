# Copy to .env (`make env` does it) and adjust. .env is git-ignored.

# --- MySQL (CRM / OLTP source) ---
WM_MYSQL_ROOT_PASSWORD=change-me-root
WM_MYSQL_USER=wm_etl
WM_MYSQL_PASSWORD=change-me-etl

# --- Market data source: "s3" reads s3a://$WM_S3_BUCKET/$WM_S3_PREFIX,
#     "hdfs" lands data/market into HDFS instead (no AWS needed) ---
WM_MARKET_SOURCE=hdfs
WM_S3_BUCKET=
WM_S3_PREFIX=wm/market
WM_AWS_REGION=ap-south-1

# --- Snowflake gold publish (key-pair auth, key from ~/.snowflake) ---
WM_SNOWFLAKE_ENABLED=false
WM_SF_ACCOUNT=
WM_SF_USER=
WM_SF_ROLE=SYSADMIN
WM_SF_WAREHOUSE=WM_LOAD_WH
WM_SF_DATABASE=WM_DB
WM_SF_SCHEMA=GOLD
WM_SF_PRIVATE_KEY_FILE=/home/airflow/.snowflake/rsa_key.p8
